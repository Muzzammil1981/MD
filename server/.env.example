# ---------- Server ----------
PORT=5000
# Origin of the React client (CORS + socket.io). No trailing slash.
CLIENT_URL=http://localhost:5173
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---------- SQL Server ----------
DB_SERVER=localhost
DB_PORT=1433
# For a NAMED instance (e.g. localhost\SQLEXPRESS) set DB_INSTANCE=SQLEXPRESS and leave DB_PORT unused
# DB_INSTANCE=SQLEXPRESS
DB_NAME=MaintenenceModule
DB_USER=YOUR_SQL_USERNAME
DB_PASSWORD=YOUR_SQL_PASSWORD
# true for Azure SQL / TLS-enforced servers; false for a normal local server
DB_ENCRYPT=false
DB_TRUST_CERT=true
# SQL Server 2008 R2 needs legacy TLS (true). Use false only for SQL Server 2016+
DB_LEGACY_TLS=true

# ---------- First SuperAdmin (created once, on first start) ----------
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_EMAIL=

# ---------- Image storage ----------
# Optional. Default: <server>/uploads
# UPLOAD_DIR=D:/mehndi-uploads
